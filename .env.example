# --- Database (SQLite for the proof) ---
DATABASE_URL="file:./dev.db"

# --- CJdropshipping official API V2 (live catalog, variants, prices, inventory) ---
# CJ dashboard → Authorization → API → generate API Key.
CJ_API_KEY=""
# CJ_API_BASE_URL="https://developers.cjdropshipping.com/api2.0/v1"
# Minimum gap between CJ calls (CJ enforces per-account QPS limits).
# CJ_MIN_INTERVAL_MS=1100
# CJ_MAX_CONCURRENT=3
# Retries for HTTP 429 rate limits (CJ also limits per source IP).
# CJ_RATE_LIMIT_RETRIES=2

# --- Stripe: TEST MODE ONLY (sk_test_… ; live keys are rejected) ---
STRIPE_SECRET_KEY=""
# Optional (e.g. from `stripe listen --forward-to localhost:3000/api/stripe/webhook`)
STRIPE_WEBHOOK_SECRET=""

# --- App ---
SITE_URL="http://localhost:3000"
STORE_NAME="Tetherless"
ADMIN_USER="admin"
ADMIN_PASSWORD="change-me"

# Inventory cache: product pages use cached stock; add-to-cart / checkout re-query CJ when older than this.
INVENTORY_TTL_MINUTES=30
LOW_STOCK_THRESHOLD=20
# Default suggested retail = supplier price × this, rounded to .99 (you set the final price).
DEFAULT_MARKUP=3

# Supplier purchasing. Only "mock" exists in this build: approval records a mock supplier
# reference and NEVER creates or pays for a CJ order.
SUPPLIER_MODE="mock"
