FROM node:22-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm install
COPY scripts/irac-archive-harvester.ts ./scripts/irac-archive-harvester.ts
CMD ["npm","run","irac:archive"]
# force isolated harvester rebuild v2
