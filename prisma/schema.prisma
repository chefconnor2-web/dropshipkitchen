// Chef Supply data model.
//
// Two clearly separated layers:
//   SUPPLIER DATA  (CjSupplierProduct / CjSupplierVariant) — exactly what CJ's API returned.
//   STOREFRONT DATA (Product / ProductVariant)            — what we own, curate and show customers.
// SupplierOffer is the bridge: one storefront variant -> one exact CJ variant (VID).
// OrderItem keeps an immutable snapshot of that mapping at the moment of purchase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- SUPPLIER DATA (live CJ API) ----------

model CjSupplierProduct {
  id              String   @id @default(cuid())
  cjProductId     String   @unique // CJ PID
  cjProductSku    String
  cjProductName   String
  cjDescription   String?
  cjImages        String   @default("[]") // JSON array of CJ image URLs
  cjCategoryName  String?
  cjProductWeight Float? // grams, as reported by CJ
  cjSellPrice     String? // raw product-level sell price (can be a range)
  cjDeliveryCycle String? // CJ processing/delivery cycle (days) from Product List V2, when known
  rawJson         String // full product/query response `data`, for audit
  lastSyncedAt    DateTime
  createdAt       DateTime @default(now())

  variants CjSupplierVariant[]
  products Product[]
}

model CjSupplierVariant {
  id                 String            @id @default(cuid())
  supplierProductId  String
  supplierProduct    CjSupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  cjVariantId        String            @unique // CJ VID
  cjVariantSku       String
  variantName        String? // CJ variantNameEn
  variantKey         String? // CJ variantKey, e.g. "Black-30cm"
  variantImage       String?
  supplierPriceCents Int? // CJ variantSellPrice (USD) in cents
  weightGrams        Float?
  lengthMm           Float?
  widthMm            Float?
  heightMm           Float?
  inventoryTotal     Int? // sum over CJ warehouses; null = never checked
  inventoryJson      String? // stock/queryByVid response `data`
  inventoryCheckedAt DateTime?
  priceCheckedAt     DateTime?
  rawJson            String
  updatedAt          DateTime          @updatedAt

  offers SupplierOffer[]
}

// ---------- STOREFRONT DATA (ours) ----------

model Product {
  id                String             @id @default(cuid())
  slug              String             @unique
  title             String
  description       String             @default("")
  internalSku       String             @unique
  categories        String             @default("") // comma separated
  seoTitle          String?
  seoDescription    String?
  status            String             @default("DRAFT") // DRAFT | PUBLISHED
  estimatedDelivery String? // customer-facing text, e.g. "7–12 business days"
  optionNames       String             @default("[]") // JSON array, e.g. ["Colour","Size"]
  supplierProductId String?
  supplierProduct   CjSupplierProduct? @relation(fields: [supplierProductId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  images          ProductImage[]
  variants        ProductVariant[]
  /// false for products opened from storefront search: buyable by link, hidden from the shop grid.
  listed          Boolean          @default(true)
  /// Print-on-demand set-up (JSON, see lib/personalize-shared.ts). Null: not personalizable.
  personalizeJson String?
}

// Customer-facing images are served through /media/<id> so supplier CDN URLs never reach the browser.
model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceUrl String
  alt       String  @default("")
  position  Int     @default(0)
}

model ProductVariant {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String // e.g. "Black / 30cm"
  options     String  @default("{}") // JSON: {"Colour":"Black","Size":"30cm"}
  internalSku String  @unique
  priceCents  Int
  imageUrl    String? // source URL; served via /media/v/<variantId>
  enabled     Boolean @default(true)
  position    Int     @default(0)

  offer     SupplierOffer?
  cartItems CartItem[]
  boxPools  MysteryBoxPoolItem[]
}

// The bridge: exactly one supplier variant behind each storefront variant.
model SupplierOffer {
  id                  String            @id @default(cuid())
  productVariantId    String            @unique
  productVariant      ProductVariant    @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  supplier            String            @default("CJ")
  supplierProductId   String // CJ PID
  supplierProductSku  String // CJ product SKU
  supplierVariantId   String // CJ VID
  supplierSku         String // CJ variant SKU
  cjSupplierVariantId String
  cjSupplierVariant   CjSupplierVariant @relation(fields: [cjSupplierVariantId], references: [id])
}

// ---------- CART / ORDERS ----------

model Cart {
  id         String     @id @default(cuid())
  /// The signed-in owner. An owned cart only opens for that customer.
  customerId String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]
  boxes      CartBox[]

  @@index([customerId])
}

model CartItem {
  id                String           @id @default(cuid())
  cartId            String
  cart              Cart             @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId         String
  variantId         String
  variant           ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity          Int
  /// A personalized line (the shopper's own design). Each design is its own line, never merged.
  personalizationId String?
  personalization   Personalization? @relation(fields: [personalizationId], references: [id], onDelete: Cascade)

  @@index([cartId, variantId])
}

/// A shopper's design for one print-on-demand item: the artwork CJ prints and a mock-up of the result.
/// Files are public at /pod/<id>/art and /pod/<id>/preview so CJ can download them, so the id is a random
/// UUID (v4), not a cuid, which is partly predictable.
model Personalization {
  id          String     @id @default(uuid())
  productId   String
  variantId   String
  kind        String // photo | text
  text        String? // the words, for text designs
  podVersion  Int // CJ POD 2 or 3, copied from the product set-up at design time
  areaName    String // CJ print area (POD 2.0)
  artMime     String
  art         Bytes
  previewMime String
  preview     Bytes
  createdAt   DateTime   @default(now())
  cartItems   CartItem[]
}

// One per email address, built from paid orders. Notes and tags are the merchant's own.
model Customer {
  id        String   @id @default(cuid())
  email     String   @unique // lower-cased
  name      String?
  phone     String?
  notes     String   @default("")
  tags      String   @default("") // comma separated
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders           Order[]
  /// Their Stripe customer (set when they subscribe), for billing and the billing portal.
  stripeCustomerId String?
  /// The merchant's own AI message limit for this person (per 30 days); null = by spend tier.
  aiLimitOverride  Int?
  subscriptions    Subscription[]

  @@index([stripeCustomerId])
}

/// The AI assistant subscription: billed monthly by Stripe. The first payment also buys a free welcome mystery box
/// (the subscriber pays its shipping once); renewals are the assistant only.
model Subscription {
  id                   String    @id @default(cuid())
  customerId           String
  customer             Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// "full" ($30-style: welcome box + AI by spend tier) or "lite" (AI only, capped by cost to keep the margin).
  plan                 String    @default("full")
  /// Full subscriptions started after monthly boxes: a surplus box every paid month (shipping billed monthly).
  /// Older ones got one welcome box with the first month only.
  monthlyBox           Boolean   @default(false)
  boxId                String
  boxName              String
  stripeSubscriptionId String    @unique
  status               String // Stripe status: active, trialing, past_due, canceled, incomplete, unpaid…
  priceCents           Int // the subscription, per month
  shippingCents        Int // welcome box shipping, paid once with the first month
  shipCountry          String
  shippingAddressJson  String? // where the welcome box goes
  cancelAtPeriodEnd    Boolean   @default(false)
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([customerId])
}

/// A paid month of a subscription that didn't come with a box (renewals): counts toward the customer's spend.
model SubscriptionPayment {
  invoiceId      String   @id
  subscriptionId String
  customerId     String
  amountCents    Int
  paidAt         DateTime

  @@index([customerId])
}

/// One AI assistant message. Limits count these over the last 30 days.
model AiUsage {
  id         String   @id @default(cuid())
  customerId String?
  visitorId  String?
  chatId     String?
  /// What the message cost us in micro-dollars ($1 = 1,000,000); null for messages from before this was measured.
  costMicros Int?
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([visitorId, createdAt])
}

/// One-tap email sign-in links (only the hash is stored).
/// Whether one product (by CJ product id) ships to one country, and the cheapest standard price for one unit.
/// Product cards show it as a badge; answers are reused for a week.
model ShipCheck {
  pid       String
  country   String
  ok        Boolean
  cents     Int?
  /// Warehouses holding the product: "US", "CN", "US,CN", "?" when unknown (see lib/warehouses.ts); null on answers from before the warehouse rule.
  origins   String?
  checkedAt DateTime @default(now())

  @@id([pid, country])
}

/// A 6-digit sign-in code emailed to a shopper. Only an HMAC of the code is stored.
model LoginCode {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  /// Wrong guesses against this code; it stops working after a few.
  attempts  Int       @default(0)
  ip        String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

/// A signed-in browser. The cookie holds a random token; only its SHA-256 is stored, so the table can't sign anyone in.
model CustomerSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  customerId String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([customerId])
}

/// Magic-link tokens from before sign-in codes; no longer issued.
model LoginToken {
  tokenHash String    @id
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Order {
  id                  String    @id @default(cuid())
  customerId          String?
  customer            Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  number              String    @unique
  status              String // PENDING_PAYMENT | AWAITING_MERCHANT_APPROVAL | PLACING_SUPPLIER_ORDER | SUPPLIER_ORDER_PLACED | APPROVED_MOCK_FULFILLMENT | DECLINED_REFUNDED | PAYMENT_FAILED
  email               String?
  customerName        String?
  shippingAddressJson String?
  subtotalCents       Int
  currency            String    @default("usd")
  stripeSessionId     String?   @unique
  stripePaymentIntent String?
  stripeRefundId      String?
  paidAt              DateTime?
  decidedAt           DateTime?
  decisionNote        String?
  mockSupplierOrderId String? // set in SUPPLIER_MODE=mock — never a real CJ order
  customerPhone       String?
  // CJ fulfilment (SUPPLIER_MODE=sandbox|live). A sandbox order never charges or ships.
  cjQuoteJson         String? // last freight quote: [{logisticName, logisticPrice, logisticAging}]
  cjFromCountry       String?
  cjLogisticName      String?
  cjSandbox           Boolean   @default(false)
  cjOrderNumber       String? // the orderNumber we sent CJ (unique per attempt)
  cjOrderId           String?
  cjShipmentOrderId   String? // what payBalanceV2 pays
  cjAmountCents       Int? // CJ's order amount (products + postage), USD
  cjPaidAt            DateTime?
  cjStatus            String? // CJ orderStatus, e.g. CREATED, UNSHIPPED, SHIPPED
  cjTrackingNumber    String?
  cjPlacedAt          DateTime?
  cjError             String?
  cjRawJson           String? // last createOrder / getOrderDetail response data
  createdAt           DateTime  @default(now())

  items               OrderItem[]
  /// Shipping the customer paid (CJ's quote, passed through at cost) and the CJ method it was quoted for.
  shippingCents       Int           @default(0)
  customerShipMethod  String?
  customerShipCountry String?
  /// Set when the order ships as several CJ parcels (too heavy for one): [{items:[{vid,quantity}], method, cents}]
  parcelPlanJson      String?
  parcels             OrderParcel[]
  /// Subscription box orders: the Stripe invoice that paid for this box (one order per invoice).
  stripeInvoiceId     String?
  subscriptionId      String?

  /// Carrier tracking, kept fresh by lib/tracking.ts. Stage: label | in_transit | out_for_delivery | delivered | exception
  trackingStage       String?
  trackingStatus      String? // the carrier's own words, shown as the latest update
  trackingEta         String? // CJ's delivery estimate, e.g. "7-12" (days)
  lastMileCarrier     String?
  lastMileNumber      String?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  trackingCheckedAt   DateTime?
  trackingEvents      TrackingEvent[]

  @@index([stripeInvoiceId])
  @@index([status, deliveredAt])
}

/// One step on an order's tracking timeline (a stage change, with the carrier's words). parcelIndex is set on split orders.
model TrackingEvent {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  parcelIndex Int?
  stage       String
  detail      String?
  at          DateTime @default(now())

  @@index([orderId, at])
}

// Immutable purchase snapshot. Deliberately NOT relationally dependent on Product for its data.
model OrderItem {
  id                         String    @id @default(cuid())
  orderId                    String
  order                      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId                  String? // soft references for navigation only
  productVariantId           String?
  productTitle               String
  variantName                String
  internalSku                String
  quantity                   Int
  customerPriceCents         Int
  supplier                   String
  supplierProductId          String // CJ PID
  supplierProductSku         String
  supplierVariantId          String // CJ VID
  supplierSku                String // CJ variant SKU
  supplierPriceAtOrderCents  Int?
  supplierInventoryAtOrder   Int?
  supplierInventoryCheckedAt DateTime?

  checks            SupplierCheck[]
  /// Set on items that came out of a mystery box (revealed after payment); same group = same box.
  mysteryBoxName    String?
  mysteryBoxGroup   String?
  /// The shopper's design for a print-on-demand item (Personalization id); sent to CJ as podProperties.
  personalizationId String?
}

// Every live re-check against CJ for an order item, kept as evidence.
model SupplierCheck {
  id                String    @id @default(cuid())
  orderItemId       String
  orderItem         OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  supplierVariantId String
  priceCents        Int?
  inventoryTotal    Int?
  ok                Boolean
  error             String?
  checkedAt         DateTime  @default(now())
}

// ---------- INTEGRATION BOOKKEEPING ----------

// One row per real HTTP call to CJ — the audit trail that proves data came from the official API.
model CjApiCall {
  id         String   @id @default(cuid())
  method     String
  path       String
  query      String?
  httpStatus Int?
  cjCode     Int?
  ok         Boolean
  message    String?
  requestId  String?
  durationMs Int
  createdAt  DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// "Tell me when it launches" sign-ups for Link line products that aren't buyable yet.
model WaitlistEntry {
  id         String    @id @default(cuid())
  email      String
  platform   String
  productId  String
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  @@unique([email, platform, productId])
  @@index([platform, productId])
}

/// Every customer/merchant email the store renders, sent or not, so the admin can see and resend it.
model EmailLog {
  id         String   @id @default(cuid())
  orderId    String?
  kind       String // order_confirmation | order_shipped | order_refunded | merchant_new_order | test
  to         String
  subject    String
  html       String
  text       String
  status     String // sent | failed | not_configured
  providerId String?
  error      String?
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
}

/// One shopper's conversation with the sourcing assistant. `messagesJson` is the exact Anthropic message
/// history (append-only); `uiJson` is what the chat panel shows (text, product cards, cart notices).
model AssistantChat {
  id           String   @id @default(cuid())
  /// Anonymous browser id (cs_vid cookie): a visitor's chat history.
  visitorId    String?
  /// The signed-in owner. Once set, only that customer can open the chat (the visitor id no longer counts).
  customerId   String?
  title        String   @default("New chat")
  messagesJson String   @default("[]")
  uiJson       String   @default("[]")
  userTurns    Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([visitorId, updatedAt])
  @@index([customerId, updatedAt])
}

/// A photo a shopper attached in the assistant chat (resized in the browser, so small enough for SQLite).
model AssistantImage {
  id         String   @id @default(cuid())
  visitorId  String
  /// Set with the chat's owner; then only that customer can see the photo.
  customerId String?
  chatId     String?
  mime       String
  data       Bytes
  createdAt  DateTime @default(now())

  @@index([chatId])
}

/// One CJ order of a split shipment (orders too heavy for a single parcel).
model OrderParcel {
  id                String    @id @default(cuid())
  orderId           String
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  index             Int
  itemsJson         String // [{vid, quantity, lineItemId}]
  logisticName      String
  quotedCents       Int
  cjOrderNumber     String?
  cjOrderId         String?
  cjShipmentOrderId String?
  cjAmountCents     Int?
  cjPaidAt          DateTime?
  cjStatus          String?
  cjTrackingNumber  String?
  cjError           String?
  trackingStage     String?
  trackingStatus    String?
  trackingEta       String?
  lastMileCarrier   String?
  lastMileNumber    String?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime  @default(now())

  @@unique([orderId, index])
}

/// A shopper asking for a freight quote on a large order (pallets, sea/air freight arranged with CJ by hand).
model FreightRequest {
  id               String   @id @default(cuid())
  email            String
  company          String?
  notes            String   @default("")
  country          String
  postalCode       String   @default("")
  itemsJson        String // [{title, option, quantity, unitCents, pid}]
  subtotalCents    Int
  parcelQuoteCents Int? // what parcel shipping would cost, for comparison
  status           String   @default("new") // new | quoted | won | lost
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// A mystery box an AI designed from a brief. Each purchase draws items at random from its pool,
/// always worth at least `guaranteedValueCents` at list price and leaving at least `minProfitCents`.
model MysteryBox {
  id                   String               @id @default(cuid())
  slug                 String               @unique
  name                 String
  tagline              String               @default("")
  description          String               @default("")
  brief                String               @default("")
  priceCents           Int
  itemCount            Int
  guaranteedValueCents Int
  minProfitCents       Int
  status               String               @default("DRAFT") // DRAFT | PUBLISHED
  buildLog             String               @default("")
  pool                 MysteryBoxPoolItem[]
  cartBoxes            CartBox[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

model MysteryBoxPoolItem {
  id        String         @id @default(cuid())
  boxId     String
  box       MysteryBox     @relation(fields: [boxId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([boxId, variantId])
}

/// One mystery box in a cart. Its contents are drawn when it's added (so shipping can be quoted) and stay hidden.
model CartBox {
  id        String     @id @default(cuid())
  cartId    String
  cart      Cart       @relation(fields: [cartId], references: [id], onDelete: Cascade)
  boxId     String
  box       MysteryBox @relation(fields: [boxId], references: [id], onDelete: Cascade)
  picksJson String // [variantId]
  createdAt DateTime   @default(now())
}

/// Remembered CJ shipping quotes, so prices show instantly (and survive restarts). Old ones are shown at once
/// and refreshed in the background; checkout always uses a fresh one. Also the data for weight-based estimates.
model ShippingQuote {
  key      String   @id // items + country + postcode prefix (see lib/shipping.ts)
  country  String
  grams    Int? // total weight of the quoted items, when every item's weight is known
  json     String // CartQuote
  quotedAt DateTime

  @@index([country, quotedAt])
}
